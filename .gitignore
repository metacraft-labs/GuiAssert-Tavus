# Nim build artefacts.
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
nimblecache/
*.exe
*.dSYM
tests/ttavus

# Editor / OS noise.
.DS_Store
*.swp
*.bak

# Nix results.
/result
/result-*


# Local scratch — never commit credentials or render outputs.
/.env
/.env.*
/tmp/

# User-local direnv overrides (e.g. age-secrets loader for API keys).
/user.envrc
/.direnv/
tests/temotive_translation
tests/tnimcache_is_worktree_local

# Repro development environment artifacts
.repro/
